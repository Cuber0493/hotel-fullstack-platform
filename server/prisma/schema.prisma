generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(GUEST)
  refreshTokens RefreshToken[]
  bookings      Booking[]
  enquiries     Enquiry[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Property {
  id          String     @id @default(uuid())
  name        String
  city        String     @default("Mumbai")
  address     String
  description String     @db.Text
  amenities   String[]
  imageUrls   String[]
  roomTypes   RoomType[]
  rooms       Room[]
  enquiries   Enquiry[]
  reviews     Review[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([city])
  @@index([name])
  @@map("properties")
}

model RoomType {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  canonicalName String
  description   String   @db.Text
  capacity      Int
  baseRateInr   Decimal  @db.Decimal(10, 2)
  rooms         Room[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, canonicalName])
  @@index([propertyId])
  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomNumber String
  status     RoomStatus @default(AVAILABLE)
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

model Booking {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  roomId           String
  room             Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkIn          DateTime      @db.Date
  checkOut         DateTime      @db.Date
  guests           Int           @default(1)
  status           BookingStatus @default(CONFIRMED)
  totalInr         Decimal       @db.Decimal(10, 2)
  originalCurrency String        @default("INR")
  originalAmount   Decimal       @db.Decimal(10, 2)
  review           Review?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([roomId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([userId])
  @@map("bookings")
}

model Enquiry {
  id         String        @id @default(uuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  email      String
  message    String        @db.Text
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([userId])
  @@map("enquiries")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model Upload {
  id        String   @id @default(uuid())
  ownerType String
  ownerId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("uploads")
}
