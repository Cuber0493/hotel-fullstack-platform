generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model User {
  id            String         @id @default(uuid())
  name          String
  fullName      String?
  email         String         @unique
  phone         String?
  passwordHash  String
  role          Role           @default(GUEST)
  refreshTokens RefreshToken[]
  bookings      Booking[]
  enquiries     Enquiry[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Property {
  id            String     @id @default(uuid())
  slug          String     @unique
  name          String
  city          String     @default("Mumbai")
  neighborhood  String     @default("Colaba, South Mumbai")
  address       String
  description   String     @db.Text
  heroImage     String     @default("")
  galleryImages String[]   @default([])
  amenities     String[]   @default([])
  checkInTime   String     @default("14:00")
  checkOutTime  String     @default("11:00")
  contactPhone  String     @default("+91 22 6900 1400")
  contactEmail  String     @default("concierge@bombayreserve.com")
  roomTypes     RoomType[]
  rooms         Room[]
  enquiries     Enquiry[]
  reviews       Review[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([city])
  @@index([name])
  @@index([slug])
  @@map("properties")
}

model RoomType {
  id             String        @id @default(uuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug           String        @default("")
  name           String        @default("")
  canonicalName  String
  description    String        @db.Text
  capacity       Int           @default(2)
  maxGuests      Int           @default(2)
  baseRateInr    Decimal       @default(0) @db.Decimal(10, 2)
  basePrice      Decimal       @default(0) @db.Decimal(10, 2)
  bedCount       Int           @default(1)
  bedType        String        @default("King Bed")
  roomSizeSqFt   Int           @default(400)
  amenities      String[]      @default([])
  images         String[]      @default([])
  totalInventory Int           @default(1)
  rooms          Room[]
  bookingItems   BookingItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([propertyId, canonicalName])
  @@index([propertyId])
  @@index([slug])
  @@map("room_types")
}

model Room {
  id           String        @id @default(uuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomNumber   String
  floor        String        @default("1")
  status       RoomStatus    @default(AVAILABLE)
  bookings     Booking[]
  bookingItems BookingItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

model Booking {
  id                 String        @id @default(uuid())
  bookingCode        String        @unique @default("")
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  roomId             String?
  room               Room?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestName          String        @default("")
  guestEmail         String        @default("")
  guestPhone         String        @default("")
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  checkInDate        DateTime      @default(now()) @db.Date
  checkOutDate       DateTime      @default(now()) @db.Date
  guests             Int           @default(1)
  totalGuests        Int           @default(1)
  status             BookingStatus @default(CONFIRMED)
  totalInr           Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal       @default(0) @db.Decimal(10, 2)
  originalCurrency   String        @default("INR")
  originalAmount     Decimal       @default(0) @db.Decimal(10, 2)
  specialRequests    String?       @db.Text
  cancellationReason String?       @db.Text
  items              BookingItem[]
  review             Review?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([roomId])
  @@index([bookingCode])
  @@index([checkIn, checkOut])
  @@index([checkInDate, checkOutDate])
  @@index([status, checkIn, checkOut])
  @@index([status])
  @@index([userId])
  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  nightPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([roomTypeId])
  @@index([roomId])
  @@map("booking_items")
}

model Enquiry {
  id            String        @id @default(uuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  email         String
  message       String        @db.Text
  internalNotes String?       @db.Text
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([userId])
  @@map("enquiries")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model Upload {
  id        String   @id @default(uuid())
  ownerType String
  ownerId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("uploads")
}
