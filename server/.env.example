# Server Environment Variables Template
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_bombay_reserve?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_bombay_reserve
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
USD_TO_INR_RATE=86.50
CORS_ORIGIN=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@bombayreserve.com
ADMIN_PASSWORD=Password@123
ADMIN_NAME="Anya Mehta"

# Cloudinary Media Storage (Optional for local test mock)
CLOUDINARY_CLOUD_NAME=the_bombay_reserve
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# Redis & Background Queue (BullMQ + Upstash)
REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=concierge@bombayreserve.com
