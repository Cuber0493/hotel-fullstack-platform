{
  "name": "hotel-fullstack-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Full-Stack Platform: Booking & enquiry platform for The Bombay Reserve boutique hotel group",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "hotel",
    "booking",
    "mumbai",
    "boutique-hotel",
    "express",
    "react",
    "typescript",
    "prisma",
    "zod"
  ],
  "author": "The Bombay Reserve Engineering Team",
  "license": "UNLICENSED"
}
